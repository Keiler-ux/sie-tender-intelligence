{"morceaux": [{"affaire": "2022_bureaux_fictifs_Nantes", "fichier": "memoire_technique.pdf", "page": 1, "article": null, "titre": null, "texte": "MEMOIRE TECHNIQUE - Bureaux (affaire fictive) 1. Câblage courants faibles Le câblage VDI est réalisé en catégorie 6A avec recette de chaque prise.", "meta": {"activite": "CFA", "annee": 2022, "type": "tertiaire", "resultat": "perdu"}}, {"affaire": "2023_ehpad_fictif_Reze", "fichier": "memoire_technique.pdf", "page": 1, "article": "1", "titre": "Organisation en milieu occupé", "texte": "L'établissement restant ouvert, nous travaillons chambre par chambre avec un phasage validé chaque semaine. Les coupures électriques sont annoncées 48 heures à l'avance.", "meta": {"activite": "CFO/SSI", "annee": 2023, "type": "santé", "resultat": "gagné"}}, {"affaire": "2023_ehpad_fictif_Reze", "fichier": "memoire_technique.pdf", "page": 1, "article": "2", "titre": "Sécurité incendie", "texte": "Le remplacement du SSI est réalisé sans interruption de la mise en sécurité : l'ancien et le nouveau système fonctionnent en parallèle jusqu'à la réception.", "meta": {"activite": "CFO/SSI", "annee": 2023, "type": "santé", "resultat": "gagné"}}, {"affaire": "2024_ecole_maternelle_fictive_Orvault", "fichier": "memoire_technique.pdf", "page": 1, "article": "1", "titre": "Méthodologie d'intervention en site occupé", "texte": "Nos équipes interviennent en site occupé en respectant les horaires de l'école. Les travaux bruyants sont planifiés le mercredi et pendant les vacances scolaires. Chaque zone de travaux est isolée par des barrières et un balisage, et un point hebdomadaire est tenu avec la direction de l'établissement.", "meta": {"activite": "CFO/CFA", "annee": 2024, "type": "enseignement", "resultat": "gagné"}}, {"affaire": "2024_ecole_maternelle_fictive_Orvault", "fichier": "memoire_technique.pdf", "page": 1, "article": "2", "titre": "Gestion environnementale du chantier", "texte": "Les déchets sont triés sur site dans des bennes séparées (DIB, métaux, DEEE). Les luminaires déposés sont repris par la filière agréée et les bordereaux de suivi sont transmis au maître d'ouvrage.", "meta": {"activite": "CFO/CFA", "annee": 2024, "type": "enseignement", "resultat": "gagné"}}, {"affaire": "2024_ecole_maternelle_fictive_Orvault", "fichier": "memoire_technique.pdf", "page": 1, "article": "3", "titre": "Moyens humains", "texte": "Un chargé d'affaires, un chef de chantier habilité B2V BR et deux électriciens qualifiés sont affectés au chantier.", "meta": {"activite": "CFO/CFA", "annee": 2024, "type": "enseignement", "resultat": "gagné"}}], "documents": [{"affaire": "2022_bureaux_fictifs_Nantes", "fichier": "memoire_technique.pdf", "type": "memoire", "validite": null, "meta": {"activite": "CFA", "annee": 2022, "type": "tertiaire", "resultat": "perdu"}}, {"affaire": "2023_ehpad_fictif_Reze", "fichier": "attestation_assurance_decennale.pdf", "type": "attestation", "validite": "2026-03-31", "meta": {"activite": "CFO/SSI", "annee": 2023, "type": "santé", "resultat": "gagné"}}, {"affaire": "2023_ehpad_fictif_Reze", "fichier": "memoire_technique.pdf", "type": "memoire", "validite": null, "meta": {"activite": "CFO/SSI", "annee": 2023, "type": "santé", "resultat": "gagné"}}, {"affaire": "2024_ecole_maternelle_fictive_Orvault", "fichier": "attestation_qualifelec.pdf", "type": "attestation", "validite": "2027-12-31", "meta": {"activite": "CFO/CFA", "annee": 2024, "type": "enseignement", "resultat": "gagné"}}, {"affaire": "2024_ecole_maternelle_fictive_Orvault", "fichier": "memoire_technique.pdf", "type": "memoire", "validite": null, "meta": {"activite": "CFO/CFA", "annee": 2024, "type": "enseignement", "resultat": "gagné"}}]}